# Public frontend values only. Copy from Supabase → Project Settings → Data API (or API).
# Never put the service_role key in the React app or any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Mudra Sanchay

# Server-only. Do not prefix with VITE_.
# In a shared Supabase project, SUPABASE_SERVICE_ROLE_KEY must be the service_role secret
# (Project Settings → API), not the same anon/publishable key used by the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: used only for password sign-in on the API (safe to be the anon key).
SUPABASE_ANON_KEY=
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=8787
NODE_ENV=development
